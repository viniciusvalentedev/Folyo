# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).
# O ".env.local" NUNCA vai para o GitHub (está no .gitignore).
#
# Regras importantes:
#  - Variáveis que começam com NEXT_PUBLIC_ podem aparecer no navegador. Só coloque nelas
#    o que pode ser público: a URL do projeto e a chave "publishable" (sb_publishable_...).
#    Ela só consegue o que as regras de segurança (RLS) do banco deixam.
#  - A chave SECRETA (sb_secret_...) só é usada pela rota do webhook de pagamento (veja o fim deste
#    arquivo). Fora disso, não coloque ela aqui, nem no GitHub, nem em conversas. Guarde só no
#    gerenciador de senhas.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole_aqui

# CAPTCHA da Cloudflare (Turnstile): a SITE KEY é pública. A SECRET KEY do Turnstile vai só no
# painel do Supabase (Authentication → Attack Protection), nunca aqui. Sem esta linha, o site
# funciona sem CAPTCHA (útil no seu computador).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Bunny Stream (vídeo das aulas enviado pelo painel). SÓ SERVIDOR: nunca use NEXT_PUBLIC_ aqui.
# Bunny → Stream → sua Video Library: o número da biblioteca está na URL; a "API Key" e a
# "Token Authentication Key" ficam em Library → API e em Security. Em Security, ligue também
# "Token Authentication" e "Block direct URL access" para o vídeo só abrir com o token da Folyo.
# Sem estas três linhas, o painel continua funcionando: só o envio de vídeo fica desligado
# (as aulas podem usar vídeo por link).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# Limite de pedidos COMPARTILHADO entre os servidores da Vercel (opcional, SÓ SERVIDOR: nunca NEXT_PUBLIC_).
# Sem ele, os limites de entrada e cadastro contam em memória, por servidor (funciona, mas é menos firme).
# Como ligar: upstash.com → Redis → Create database (plano grátis basta) → aba REST API → copie as duas linhas.
# Na Vercel, a integração "Upstash Redis" do Marketplace cria KV_REST_API_URL e KV_REST_API_TOKEN, que também valem.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Endereço oficial do site (usado em canonical, sitemap, robots e imagem de compartilhamento).
# Sem esta linha vale https://www.usefolyo.com. Sem barra no fim.
# O Google só indexa na PRODUÇÃO da Vercel; previews e desenvolvimento ficam sempre fechados.
NEXT_PUBLIC_SITE_URL=https://www.usefolyo.com

# ---------------------------------------------------------------------------------------------------
# Pagamentos (Mercado Pago). TUDO AQUI É SÓ SERVIDOR: nunca use NEXT_PUBLIC_, nunca coloque no GitHub, nunca
# cole em conversa (nem com o Claude). Guarde no gerenciador de senhas e coloque direto na Vercel e no .env.local.
#
# Na Vercel (Settings → Environment Variables), escolha o ambiente de cada valor:
#   - credenciais de TESTE do Mercado Pago  → só Preview e Development;
#   - credenciais de PRODUÇÃO               → só Production.
# Sem estas linhas (ou com PAYMENTS_ENABLED diferente de "true"), a venda fica desligada: /finalizar avisa que o
# pagamento online ainda não está disponível e ninguém é cobrado.
#
# Mercado Pago → Suas integrações → sua aplicação → Credenciais (o "Access Token") e Webhooks (a "chave secreta").
# URL do webhook a cadastrar no painel (evento "Pagamentos"):  https://www.usefolyo.com/api/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Liga a venda. Qualquer valor diferente de "true" desliga (os webhooks de pedidos já criados continuam sendo processados).
PAYMENTS_ENABLED=false
# Só em teste: "true" usa o link de pagamento de teste (sandbox) do Mercado Pago.
MERCADOPAGO_USE_SANDBOX_URL=false

# Chave SECRETA do Supabase (sb_secret_...): usada SÓ pela rota do webhook, para executar uma única função do banco
# (apply_payment), a única liberada para ela. Só Production (e Preview, se você testar o webhook por lá).
SUPABASE_SECRET_KEY=

# E-mail de recibo da compra, pelo SMTP da Zoho. Use os MESMOS dados que estão em Supabase → Authentication → SMTP.
# Só servidor; sem estas variáveis o recibo não é enviado (a venda e a liberação do curso funcionam do mesmo jeito).
# Servidor SMTP da Zoho (depende da região da sua conta; ex.: smtp.zoho.com)
SMTP_HOST=
# 465 (SSL, padrão) ou 587 (STARTTLS)
SMTP_PORT=465
# E-mail da conta Zoho e a senha (com verificação em duas etapas, use uma "senha de aplicativo" da Zoho)
SMTP_USER=
SMTP_PASSWORD=
# Remetente: a Zoho só aceita o endereço da própria conta (ou um alias dela). Ex.: Folyo <contato@usefolyo.com>
EMAIL_FROM=
