# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys / Data API).
# O ".env.local" NUNCA vai para o GitHub (está no .gitignore).
#
# Regras importantes:
#  - Variáveis que começam com NEXT_PUBLIC_ podem aparecer no navegador. Só coloque nelas
#    o que pode ser público: a URL do projeto e a chave "publishable" (sb_publishable_...).
#    Ela só consegue o que as regras de segurança (RLS) do banco deixam.
#  - A chave SECRETA (sb_secret_...) NÃO é usada pela Folyo nesta etapa. Não coloque ela
#    aqui, nem na Vercel, nem no GitHub, nem em conversas. Guarde só no gerenciador de senhas.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole_aqui

# CAPTCHA da Cloudflare (Turnstile): a SITE KEY é pública. A SECRET KEY do Turnstile vai só no
# painel do Supabase (Authentication → Attack Protection), nunca aqui. Sem esta linha, o site
# funciona sem CAPTCHA (útil no seu computador).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
